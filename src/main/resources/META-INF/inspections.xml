        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Type checking"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptTypeCheckerInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Parameter constant values"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptParameterConstantInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Parameter metadata"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptParameterMetadataInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="RSDoc consistency"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptDocConsistencyInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Duplicate switch labels"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptDuplicateSwitchLabelInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Empty control-flow body"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptEmptyControlFlowBodyInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Unreachable code"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptUnreachableCodeInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Redundant calc wrapper"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptRedundantCalcInspection"/>
        <localInspection language="RuneScript"
                         groupName="RuneScript"
                         displayName="Unused local variable"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptUnusedLocalVariableInspection"/>
        <localInspection language="RuneScriptSymbol"
                         groupName="RuneScript"
                         displayName="Invalid symbol file"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="io.runescript.plugin.ide.inspections.RuneScriptInvalidSymbolFileInspection"/>
    </extensions>
</idea-plugin>
